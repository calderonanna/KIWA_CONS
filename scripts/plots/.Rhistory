setwd("/Users/abc6435/Desktop/KIWA_CONS/data/pca")
pca <- read_table2("virens.eigenvec", col_names = FALSE)
eigenval <- scan("virens.eigenval")
#Remove duplicated column
pca <- pca[,-1]
names(pca)[1] <- "ind"
pca$ind <- as.character(pca$ind)
names(pca)[2:ncol(pca)] <- paste0("PC", 1:(ncol(pca)-1))
#Add pop info
pca$pop <- c(rep("NY",3), rep("AR",3), rep("IN",3), rep("NC",3), rep("TN",3))
pve <- data.frame(PC = 1:15, pve= eigenval/sum(eigenval)*100)
ggplot(pve, aes(PC, pve)) +
geom_bar(stat="identity")
colors = c("NY"="#211091","IN"="#2FA896","AR"="#69E6FF","TN"="#00A6FF","NC"="#992FE0")
ggplot(pca, aes(PC1, PC2, fill=pop)) +
geom_point(size=3, shape=21, color="black") +
scale_fill_manual(values = colors) +
coord_equal() +
xlab(paste0("PC1 (", signif(pve$pve[1], 3), "%)")) +
ylab(paste0("PC2 (", signif(pve$pve[2], 3), "%)")) +
theme(
legend.title = element_blank(),
panel.background = element_blank(),
panel.border = element_rect(color="black", fill=NA),
panel.grid.major = element_line(color="grey90"),
panel.grid.minor = element_blank())
pca
ggplot(pca, aes(PC1, PC2, fill=pop)) +
geom_point(size=3, shape=21, color="black") +
scale_fill_manual(values = colors) +
coord_equal() +
xlab(paste0("PC1 (", signif(pve$pve[1], 3), "%)")) +
ylab(paste0("PC2 (", signif(pve$pve[2], 3), "%)")) +
geom_text(aes(label = pca$ind), nudge_y = 0.5, check_overlap = TRUE) +
theme(
legend.title = element_blank(),
panel.background = element_blank(),
panel.border = element_rect(color="black", fill=NA),
panel.grid.major = element_line(color="grey90"),
panel.grid.minor = element_blank())
ggplot(pca, aes(PC1, PC2, fill=pop)) +
geom_point(size=3, shape=21, color="black") +
scale_fill_manual(values = colors) +
coord_equal() +
xlab(paste0("PC1 (", signif(pve$pve[1], 3), "%)")) +
ylab(paste0("PC2 (", signif(pve$pve[2], 3), "%)")) +
geom_text(aes(label = pca$ind), check_overlap = TRUE) +
theme(
legend.title = element_blank(),
panel.background = element_blank(),
panel.border = element_rect(color="black", fill=NA),
